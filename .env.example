BETTER_AUTH_SECRET="replace_me_with_a_long_random_secret"
# Generate one with: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TELEMETRY=0

# Matches the MySQL container defined in docker-compose.yml.
# Start the database with: pnpm db:up
DATABASE_URL="mysql://betterauth:betterauth@localhost:3306/betterauth_vatsim"

VATSIM_AUTH_URL="https://auth-dev.vatsim.net"
VATSIM_CLIENT_ID=id
VATSIM_CLIENT_SECRET=secret
